# Copy to client/.env and fill in. Loaded by start.sh / fetch-params.sh.
# GITIGNORED - this file is per-machine and never committed.

# ===== REQUIRED =====
# From the server deploy output, or run ./fetch-params.sh to pull them from the
# server automatically (needs SSH access - see SSH section below).
SERVER_ADDR=
SERVER_PORT=443
UUID=
REALITY_PUBLIC_KEY=
REALITY_SHORT_ID=
REALITY_SNI=m365.cloud.microsoft

# ===== OPTIONAL (defaults shown) =====
# Local SOCKS proxy endpoint - all traffic to this port tunnels to the server
SOCKS_LISTEN=127.0.0.1
SOCKS_PORT=1080

# REALITY client settings
FINGERPRINT=chrome
FLOW=xtls-rprx-vision

# ===== OPTIONAL: only used by ./fetch-params.sh =====
# SSH access to the server as the remote user (deploy-user by default).
# SSH_KEY must point to a private key that can log in - on this machine, not
# the deploy machine. Copy your key here, or add a new authorized key via the
# root console (edit /home/deploy-user/.ssh/authorized_keys).
SSH_USER=deploy-user
SSH_PORT=22022
SSH_KEY=

# Copy to deploy/.env and fill in. deploy/.env is auto-loaded by deploy.sh and is GITIGNORED.
# Never commit deploy/.env.

# ===== REQUIRED =====
# DigitalOcean API token (read/write). Create at https://cloud.digitalocean.com/account/api/tokens
# Used by doctl (deploy.sh maps it to DIGITALOCEAN_ACCESS_TOKEN) - or run `doctl auth init` instead.
DO_API_KEY=

# ===== OPTIONAL (defaults shown) =====
# Droplet placement
REGION=sgp1
SIZE=s-1vcpu-512mb-10gb
IMAGE=ubuntu-24-04-x64
DROPLET_NAME=vless-reality

# Account usernames (both configurable)
DEPLOY_USER=deploy-user
ADMIN_USER=admin-user

# SSH access port (firewalled + rate-limited + fail2ban jail follow this)
SSH_PORT=22022

# REALITY camouflage target - MUST be REALITY-compatible (microsoft sites are NOT;
# tested working: www.apple.com, www.amazon.com, www.samsung.com, www.bing.com,
# www.wikipedia.org, www.cloudflare.com, www.lovelive-anime.jp)
REALITY_SNI=www.apple.com
REALITY_DEST=www.apple.com:443
